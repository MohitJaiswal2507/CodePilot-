BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# Neon Auth Configuration (Managed Better Auth JWKS verification)
NEON_AUTH_URL=https://ep-silent-sound-bdj25ci7.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-silent-sound-bdj25ci7.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://ep-silent-sound-bdj25ci7.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_AUDIENCE=
ALLOW_DEV_FALLBACK_AUTH=true

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
GEMINI_ADVANCED_MODEL=gemini-2.5-pro
MODEL_CACHE_TTL_SECONDS=3600

# Vector Database and Embedding Configuration
CHROMA_PERSIST_DIR=chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_FILE_SIZE_MB=15
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.35
