BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# Neon Auth Configuration (Managed Better Auth JWKS verification)
NEON_AUTH_URL=https://ep-silent-sound-bdj25ci7.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-silent-sound-bdj25ci7.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://ep-silent-sound-bdj25ci7.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_AUDIENCE=
ALLOW_DEV_FALLBACK_AUTH=true

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
GEMINI_ADVANCED_MODEL=gemini-2.5-pro
GEMINI_REQUEST_TIMEOUT_MS=120000
MODEL_CACHE_TTL_SECONDS=3600

# Lightweight LLM Observability Configuration
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_PATH=

# Vector Database and Embedding Configuration
CHROMA_PERSIST_DIR=chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_FILE_SIZE_MB=15
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.35

# Docker Sandbox Execution Engine
SANDBOX_ENABLED=true
SANDBOX_DOCKER_PYTHON_IMAGE=python:3.12-slim
SANDBOX_DOCKER_PYTHON_DIGEST=sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
SANDBOX_DOCKER_JAVA_IMAGE=eclipse-temurin:21-jdk
SANDBOX_DOCKER_JAVA_DIGEST=sha256:ebfbb18d11ff163ee83b21258acf12248af48d22a0fdfdc68fa1a1516c05976a
SANDBOX_DOCKER_CPP_IMAGE=gcc:14
SANDBOX_DOCKER_CPP_DIGEST=sha256:a257536c9b7a0ee193c1880f2d691358d2c9760ef0ede3ee741aa243789743c7
SANDBOX_DOCKER_PULL_POLICY=never
SANDBOX_PYTHON_MEMORY_MB=128
SANDBOX_JAVA_MEMORY_MB=512
SANDBOX_CPP_MEMORY_MB=512
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_TIMEOUT_SECONDS=30
SANDBOX_COMPILE_TIMEOUT_SECONDS=10
SANDBOX_MAX_COMPILE_TIMEOUT_SECONDS=30
SANDBOX_STOP_TIMEOUT_SECONDS=1
SANDBOX_MAX_SOURCE_SIZE_BYTES=51200
SANDBOX_MAX_STDIN_SIZE_BYTES=65536
SANDBOX_MAX_OUTPUT_SIZE_BYTES=65536
SANDBOX_MAX_CONCURRENT_EXECUTIONS=4
SANDBOX_MAX_USER_CONCURRENT_EXECUTIONS=2
SANDBOX_RATE_LIMIT_REQUESTS=15
SANDBOX_RATE_LIMIT_WINDOW_SECONDS=60
